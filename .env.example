# SIRO - 環境變數範本
# 複製本檔為 .env 並填入你的值，bridge/ 與 agent/ 模組會讀取
#
# 2026-06-02 更新：因為官方 WSL installer 壞掉，用 clone+uv 模式裝，
# hermes 實際路徑在 ~/hermes-agent/.venv/Scripts/hermes.exe（Windows）
# 或 ~/hermes-agent/.venv/bin/hermes（Linux/macOS）。

# ============ LLM Provider ============
# Hermes Agent 預設讀 ~/.hermes/.env，這裡的設定是給 bridge 直接看。
# 主要 LLM provider 與 key 請到 hermes setup 設定。

# 預設用雲端 Anthropic (MiniMax-M3)
HERMES_LLM_PROVIDER=anthropic
HERMES_LLM_BASE_URL=https://api.minimax.io/anthropic
HERMES_LLM_MODEL=MiniMax-M3

# 雲端 fallback（可選，要填 key）
# HERMES_LLM_PROVIDER=nous
# HERMES_API_KEY=your_nous_api_key_here
# HERMES_LLM_MODEL=hermes-3-llama-3.1-70b

# ============ Primary LLM (雲端 Anthropic 相容) ============
# SIRO 對話預設走這台。timeout 觸發 → fallback 到本地 Ollama。
# API key 不要 commit 到 git（這檔 .env 已被 .gitignore 排除）
SIRO_PRIMARY_LLM_PROVIDER=anthropic
SIRO_PRIMARY_LLM_BASE_URL=https://api.minimax.io/anthropic
SIRO_PRIMARY_LLM_MODEL=MiniMax-M3
SIRO_PRIMARY_LLM_API_KEY=sk-cp-REPLACE_ME
# 600 秒 = 10 分鐘沒回應 → fallback 到本地
SIRO_PRIMARY_LLM_TIMEOUT_SEC=600

# ============ Fallback LLM (本地 Ollama) ============
# Primary timeout 觸發、網路斷、Hermes 死掉 → 走這台
SIRO_FALLBACK_LLM_PROVIDER=ollama
SIRO_FALLBACK_LLM_BASE_URL=http://localhost:11434
SIRO_FALLBACK_LLM_MODEL=llama3.2:3b-instruct-q4_0

# ============ Bridge Server ============
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8001
BRIDGE_LOG_LEVEL=INFO

# ============ Hermes Agent 路徑 ============
# 安裝模式 A（官方 installer）會裝在這
# HERMES_BIN_PATH=~/.local/bin/hermes

# 安裝模式 B（clone + uv，現在用的）會在這
HERMES_BIN_PATH=~/hermes-agent/.venv/Scripts/hermes.exe

# Hermes 設定檔位置
HERMES_HOME=~/.hermes

# ============ v1.5.2 Unity 對話模式 ============
# - SIRO_STREAMING=true → /ws 走 chat_stream、Unity 收 delta chunk
# - SIRO_USE_TOOL_CALLING=true → LLM 可用 set_mood / play_motion
# - SIRO_USE_AGENT_MODE=true → LLM 可 call 15 個 computer control tools
# - SIRO_TTS_STREAMING=true → sentence-level TTS streaming(LLM 出句立即觸發 TTS 推 audio)
#                            Phase 2 STT 必開(否則講話後 Mao 不會回應)
SIRO_STREAMING=true
SIRO_USE_TOOL_CALLING=true
SIRO_USE_AGENT_MODE=true
SIRO_TTS_STREAMING=true

# ============ Personality (角色人格) ============
DEFAULT_PERSONALITY=friendly_companion
