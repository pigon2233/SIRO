# SIRO - 環境變數範本
# 複製本檔為 .env 並填入你的值，bridge/ 與 agent/ 模組會讀取

# ============ LLM Provider ============
# 選一個設定即可

# 選項 A: Nous Portal（Hermes 官方推薦，一站管理多模型）
HERMES_LLM_PROVIDER=nous
HERMES_API_KEY=your_nous_api_key_here
HERMES_LLM_MODEL=hermes-3-llama-3.1-70b

# 選項 B: OpenRouter（多模型路由）
# HERMES_LLM_PROVIDER=openrouter
# HERMES_API_KEY=your_openrouter_key_here
# HERMES_LLM_MODEL=anthropic/claude-3.5-sonnet

# 選項 C: 本地 Ollama（離線測試用）
# HERMES_LLM_PROVIDER=ollama
# HERMES_LLM_BASE_URL=http://localhost:11434
# HERMES_LLM_MODEL=llama3.1:8b

# ============ Bridge Server ============
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8001
BRIDGE_LOG_LEVEL=INFO

# ============ Hermes Agent 路徑 ============
# 預設安裝位置是 ~/.local/bin/hermes
HERMES_BIN_PATH=~/.local/bin/hermes
# Hermes 設定檔位置
HERMES_HOME=~/.hermes

# ============ Personlity (角色人格) ============
# 之後會用上，現在先預留
DEFAULT_PERSONALITY=friendly_companion
